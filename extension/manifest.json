{
  "manifest_version": 3,
  "name": "Claude Eyes",
  "version": "1.0.0",
  "description": "Receives the screenshot from the Claude Eyes app and puts it into your claude.ai / chatgpt.com chat without switching tabs.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Claude Eyes"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}