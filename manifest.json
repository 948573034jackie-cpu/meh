{
  "manifest_version": 3,
  "name": "DJ Wave Looper for YouTube",
  "short_name": "Wave Looper",
  "version": "1.7.0",
  "description": "See the whole song as a DJ waveform, click to set an A–B loop, slow it down (50/75/100%) and auto speed-up trainer. Built for singers and players.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "DJ Wave Looper: open or close the looper on a YouTube video",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+L" },
      "description": "Open or close the Wave Looper panel"
    }
  },
  "permissions": ["storage", "unlimitedStorage", "scripting"],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*", "https://lrclib.net/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["src/core.js", "src/panel-css.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
