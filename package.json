{
  "name": "dream-read",
  "productName": "Dream Read",
  "version": "0.2.0",
  "description": "Dream Read: a calm reading and listening app for English learners. Reads EPUB, PDF and pasted text aloud with word highlighting, tap-to-translate, and spoken AI explanations.",
  "main": "dist/main/index.js",
  "private": true,
  "license": "MIT",
  "author": "Dream Read",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:e2e": "xvfb-run -a playwright test -c test/e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:mac": "npm run build && electron-builder --mac zip --arm64 --x64 --publish never",
    "dist:mac:local": "npm run build && electron-builder --mac zip -c.mac.identity=- -c.mac.hardenedRuntime=false --publish never"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "dompurify": "^3.4.17",
    "jszip": "^3.10.2",
    "msedge-tts": "^2.1.0",
    "onnxruntime-node": "1.23.2",
    "openai": "^7.38.0",
    "pdfjs-dist": "^6.4.299",
    "phonemizer": "^1.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sherpa-onnx-node": "^1.13.8",
    "unbzip2-stream": "^1.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "electron": "^44.9.0",
    "electron-builder": "^26.17.0",
    "esbuild": "^0.25.12",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "app.dreamread.desktop",
    "productName": "Dream Read",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v6/{linux,win32}/**",
      "!node_modules/sherpa-onnx-{linux,win}-*/**",
      "!node_modules/@napi-rs/canvas-{linux,win32}-*/**"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-darwin-*/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "minimumSystemVersion": "13.0.0",
      "darkModeSupport": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Dream Read uses the microphone only if you ask a question by voice."
      },
      "icon": "build/icon.png"
    },
    "npmRebuild": false,
    "compression": "normal",
    "artifactName": "DreamRead-${version}-${arch}.${ext}"
  }
}
