{
  "manifest_version": 3,
  "name": "YouTube to Claude / ChatGPT",
  "version": "3.3",
  "description": "Safari (iPhone/iPad): YouTube English: send the video and the part you paused at to Claude / ChatGPT, with subtitles, replay and your voice.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://*.tts.speech.microsoft.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send this video to Claude",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "browser-shim.js",
        "lib.js",
        "youtube.js"
      ]
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "browser-shim.js",
        "chat.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}