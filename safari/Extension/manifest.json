{
  "manifest_version": 3,
  "name": "My tutor: YouTube English",
  "version": "3.5",
  "description": "Safari (iPhone/iPad): My tutor, your own AI English teacher on YouTube (your own API key): a Level Check, stops at what is hard for you, explanations with a voice, Chinese.",
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://api.elevenlabs.io/*",
    "https://*.tts.speech.microsoft.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "My tutor",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "browser-shim.js",
        "lib.js",
        "youtube.js",
        "dream/dream-yt.js",
        "tutor-bar.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dream/dict.json.gz",
        "dream/zipf.json.gz"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ]
    }
  ],
  "options_page": "dream/options.html",
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "16.4"
    }
  }
}