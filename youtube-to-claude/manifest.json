{
  "manifest_version": 3,
  "name": "YouTube to Claude / ChatGPT",
  "version": "1.0",
  "description": "One click sends the YouTube video link and its full transcript to your claude.ai chat, so Claude knows what you are watching.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["https://www.youtube.com/*", "https://claude.ai/*", "https://chatgpt.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Send this video to Claude", "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["lib.js", "youtube.js"] },
    { "matches": ["https://claude.ai/*", "https://chatgpt.com/*"], "js": ["chat.js"] }
  ],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
