{
  "manifest_version": 3,
  "name": "My tutor: YouTube English",
  "version": "3.7",
  "description": "Your own AI English teacher on YouTube (your own API key): a Level Check, stops at what is hard for you, explanations with a natural voice, a voice call, Chinese, and one vocabulary database for your Mac and iPhone.",
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://api.elevenlabs.io/*", "https://*.tts.speech.microsoft.com/*",
    "https://lrclib.net/*", "https://api.lyrics.ovh/*", "https://api.github.com/*", "https://gist.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "My tutor",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "lib.js",
        "youtube.js",
        "dream/dream-yt.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dream/dict.json.gz",
        "dream/zipf.json.gz"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "options_page": "dream/options.html"
}
